{
  "name": "tdx-ths-linker",
  "version": "0.1.4",
  "description": "Single-Agent HTTP client and bare Windows runtime for Onclaw TDX/THS integration",
  "repository": {
    "type": "git",
    "url": "https://github.com/onclaw-dev/tdx-ths-linker.git",
    "directory": "packages/client"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "agent", "README.md"],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "import": "./dist/runtime.mjs"
    },
    "./cli": {
      "types": "./dist/cli.d.mts",
      "import": "./dist/cli.mjs"
    }
  },
  "bin": {
    "tdx-ths-linker": "./dist/cli-bin.mjs"
  },
  "scripts": {
    "prepack": "node ../../scripts/sync-package-readme.mjs",
    "build": "tsdown src/index.ts src/runtime.ts src/cli.ts src/cli-bin.ts",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsdown": "0.22.2",
    "typescript": "~5.6.3"
  },
  "license": "GPL-3.0-only"
}
